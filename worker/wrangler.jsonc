{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Deploy this Worker only as sgi-api. No routes, so this cannot replace
  // starswarm-sgi.pages.dev or the existing sgi worker at sgi.starswarm.workers.dev.
  // Remote D1 migration 0001_init.sql is already applied. Do not run it again.
  "name": "sgi-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    // Analyze LLM calls stay off until an explicit spend-cap yes.
    "ENABLE_LLM": "0",
    // Support chat answers from the FAQ pack unless this is "1".
    // "1" calls Workers AI (binding AI) and spends quota. Default is off.
    "ENABLE_SUPPORT_LLM": "0",
    // Turnstile Siteverify runs on device and Google sign-in.
    // "0" logs the result and allows the request. "1" rejects failures with 403.
    // Fail closed only when this is "1". TURNSTILE_SECRET is already a Worker
    // secret. Do not put it in this file.
    "TURNSTILE_ENFORCE": "0",
    "TURNSTILE_HOSTNAMES": "starswarm-sgi.pages.dev,sgi.starswarm.workers.dev"
  },
  // Free Workers rate limiting. Counters stay at the edge and are keyed in
  // code by CF-Connecting-IP. They are not written to D1. namespace_id values
  // must be unique in the Cloudflare account; change them if they collide.
  // Period must be 10 or 60 seconds. Limits are per location and approximate.
  "ratelimits": [
    {
      "name": "AUTH_DEVICE_LIMITER",
      "namespace_id": "841001",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "AUTH_GOOGLE_LIMITER",
      "namespace_id": "841002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "REDEEM_LIMITER",
      "namespace_id": "841003",
      "simple": { "limit": 5, "period": 60 }
    },
    {
      "name": "SUPPORT_LIMITER",
      "namespace_id": "841004",
      "simple": { "limit": 20, "period": 60 }
    }
  ],
  // Workers AI has no local simulator in this Wrangler, so an `ai` binding
  // always opens a remote session. Leave it out of this draft so `wrangler dev`
  // and tests stay offline. When a spend yes exists, add:
  // "ai": { "binding": "AI", "remote": true }
  // and set ENABLE_SUPPORT_LLM to "1". Until then the support agent uses the FAQ pack.
  "durable_objects": {
    "bindings": [
      {
        "name": "SupportChat",
        "class_name": "SupportChat"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-support-chat",
      "new_sqlite_classes": ["SupportChat"]
    }
  ],
  // RevenueCat, Apple, and Google secrets are optional. Do not commit values.
  // Set them later with `wrangler secret put` if those flows are turned on.
  // Until then they are unset and the webhook fails closed.
  // Google ID-token verification uses GOOGLE_CLIENT_ID as aud. GOOGLE_CLIENT_SECRET
  // stays required for providerStatus and is reserved for a future auth-code exchange.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sgi-api",
      // Remote D1, jurisdiction us. 0001_init.sql is already applied.
      // Do not run `wrangler d1 migrations apply --remote` again.
      // `remote: false` keeps wrangler dev and tests on local SQLite.
      // `npx wrangler deploy` from this directory publishes sgi-api only.
      "database_id": "9cb29592-5e30-4d4d-aecf-7aff7bf91a10",
      "preview_database_id": "local-sgi-api",
      "remote": false,
      "migrations_dir": "migrations"
    }
  ]
}
