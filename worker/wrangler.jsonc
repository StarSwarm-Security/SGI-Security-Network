{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // API skeleton only. Do not run `wrangler deploy`, `wrangler d1 create`,
  // or `wrangler d1 migrations apply --remote` from this package.
  // The live static app stays on Pages (starswarm-sgi.pages.dev) and the
  // existing `sgi` worker (sgi.starswarm.workers.dev). This Worker is named
  // sgi-api and has no routes, so a later deploy cannot replace that hostname.
  "name": "sgi-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-27",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "upload_source_maps": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "vars": {
    // Analyze LLM calls stay off until an explicit spend-cap yes.
    "ENABLE_LLM": "0",
    // Support chat answers from the FAQ pack unless this is "1".
    // "1" calls Workers AI (binding AI) and spends quota. Default is off.
    "ENABLE_SUPPORT_LLM": "0"
  },
  // Workers AI has no local simulator in this Wrangler, so an `ai` binding
  // always opens a remote session. Leave it out of this draft so `wrangler dev`
  // and tests stay offline. When a spend yes exists, add:
  // "ai": { "binding": "AI", "remote": true }
  // and set ENABLE_SUPPORT_LLM to "1". Until then the support agent uses the FAQ pack.
  "durable_objects": {
    "bindings": [
      {
        "name": "SupportChat",
        "class_name": "SupportChat"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1-support-chat",
      "new_sqlite_classes": ["SupportChat"]
    }
  ],
  // Names only. Values come from `wrangler secret put` or local `.dev.vars`.
  // Missing secrets warn during `wrangler dev` and are empty at runtime.
  // Webhooks fail closed until REVENUECAT_WEBHOOK_SECRET is set.
  "secrets": {
    "required": [
      "REVENUECAT_WEBHOOK_SECRET",
      "APPLE_CLIENT_ID",
      "APPLE_TEAM_ID",
      "APPLE_KEY_ID",
      "APPLE_PRIVATE_KEY",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sgi-entitlements",
      // Placeholder UUID. Not a live database. Replace only after an explicit
      // Phase 1 `wrangler d1 create`. A fixed id avoids Wrangler auto-provisioning
      // a remote database if someone runs a remote command by mistake.
      "database_id": "00000000-0000-4000-8000-000000000001",
      "preview_database_id": "local-sgi-entitlements",
      "migrations_dir": "migrations"
    }
  ]
}
